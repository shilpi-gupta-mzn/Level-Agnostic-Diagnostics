
EN {hasName "OntoUML", hasFQN "Ordium.Profile.OntoUML", hasPID "profile:ontouml:v1.0.0", hasNote "PAMoLa OntoUML profile clade v1.0.0. Profile and OntoUML are Entities; only the Ordium Core instantiates OM directly. DataValue names are their default lexemes unless explicit Literal wards add alternatives.", hasCustodian Ordium.Profile, follows Ordium.Profile, hasLinguisticType Ordium.Core.Entity,
  DT {hasName "ClassStereotype", hasFQN "Ordium.Profile.OntoUML.ClassStereotype", hasNote "OntoUML class stereotype values. The DataValue name is the default lexeme.",
    DV {hasName "abstract", hasNote "Abstract class stereotype used in OntoUML serialization/vocabulary."},
    DV {hasName "kind", hasNote "Rigid sortal that supplies an identity principle for its instances."},
    DV {hasName "subkind", hasNote "Rigid specialization of an identity provider."},
    DV {hasName "phase", hasNote "Anti-rigid sortal determined by intrinsic change; phases typically occur in partitions."},
    DV {hasName "role", hasNote "Anti-rigid sortal instantiated in a relational context."},
    DV {hasName "collective", hasNote "Rigid sortal for collective individuals."},
    DV {hasName "quantity", hasNote "Rigid sortal for quantities of matter."},
    DV {hasName "relator", hasNote "Relational moment / truth-maker for material relations."},
    DV {hasName "category", hasNote "Rigid non-sortal mixin aggregating essential properties across identity principles."},
    DV {hasName "phaseMixin", hasNote "Anti-rigid non-sortal mixin analogous to Phase across different identity principles."},
    DV {hasName "roleMixin", hasNote "Anti-rigid externally-dependent non-sortal mixin analogous to Role across identity principles."},
    DV {hasName "mixin", hasNote "Semi-rigid non-sortal mixin."},
    DV {hasName "mode", hasNote "Intrinsic moment with no structured value."},
    DV {hasName "quality", hasNote "Intrinsic moment associated with a quality/value structure."},
    DV {hasName "datatype", hasNote "Datatype class stereotype."},
    DV {hasName "enumeration", hasNote "Enumeration class stereotype."},
    DV {hasName "event", hasNote "Event class stereotype."},
    DV {hasName "situation", hasNote "Situation class stereotype."},
    DV {hasName "historicalRole", hasNote "Historical role class stereotype."},
    DV {hasName "historicalRoleMixin", hasNote "Historical role mixin class stereotype."},
    DV {hasName "type", hasNote "Higher-order type class stereotype."}
  },
  DT {hasName "ClassFamily", hasFQN "Ordium.Profile.OntoUML.ClassFamily", hasNote "Derived families used as profile predicates to capture the OntoUML class stereotype hierarchy.",
    DV {hasName "classStereotype", hasNote "Any OntoUML class stereotype."},
    DV {hasName "sortal", hasNote "Stereotype for class types whose instances share an identity principle."},
    DV {hasName "nonSortal", hasNote "Stereotype for dispersive/mixin-like class types that aggregate instances with different identity principles."},
    DV {hasName "aspect", hasNote "Stereotype for aspect/moment-like class types."},
    DV {hasName "identityProvider", hasNote "Sortal stereotype that supplies an identity principle."},
    DV {hasName "rigidSortal", hasNote "Rigid sortal stereotype."},
    DV {hasName "antiRigidSortal", hasNote "Anti-rigid sortal stereotype."},
    DV {hasName "rigidNonSortal", hasNote "Rigid non-sortal stereotype."},
    DV {hasName "antiRigidNonSortal", hasNote "Anti-rigid non-sortal stereotype."},
    DV {hasName "semiRigidNonSortal", hasNote "Semi-rigid non-sortal stereotype."},
    DV {hasName "dataTypeLike", hasNote "Datatype or enumeration stereotype."},
    DV {hasName "eventType", hasNote "Event stereotype family."},
    DV {hasName "situationType", hasNote "Situation stereotype family."},
    DV {hasName "historicalType", hasNote "Historical role/role-mixin family."},
    DV {hasName "higherOrderType", hasNote "Higher-order type stereotype family."}
  },
  DT {hasName "RelationStereotype", hasFQN "Ordium.Profile.OntoUML.RelationStereotype", hasNote "OntoUML relation stereotype values. The DataValue name is the default lexeme.",
    DV {hasName "formal", hasNote "Formal relation stereotype."},
    DV {hasName "material", hasNote "Material relation stereotype derived from relators and mediations."},
    DV {hasName "mediation", hasNote "Relation between a relator and the entities it connects."},
    DV {hasName "characterization", hasNote "Relation between a bearer type and its feature/moment."},
    DV {hasName "derivation", hasNote "Derivation relation stereotype."},
    DV {hasName "structuration", hasNote "Structuration relation stereotype."},
    DV {hasName "componentOf", hasNote "Part-whole relation between functional complexes."},
    DV {hasName "containment", hasNote "Containment part-whole relation stereotype."},
    DV {hasName "memberOf", hasNote "Part-whole relation between member and collective."},
    DV {hasName "subCollectionOf", hasNote "Part-whole relation between collectives."},
    DV {hasName "subQuantityOf", hasNote "Part-whole relation between quantities."},
    DV {hasName "comparative", hasNote "Comparative relation stereotype."},
    DV {hasName "externalDependence", hasNote "External dependence relation stereotype."},
    DV {hasName "historicalDependence", hasNote "Historical dependence relation stereotype."},
    DV {hasName "instantiation", hasNote "Instantiation relation stereotype."},
    DV {hasName "participation", hasNote "Relation representing an event depending on an object."},
    DV {hasName "participational", hasNote "Event decomposition relation stereotype."},
    DV {hasName "bringsAbout", hasNote "Relation stereotype for an event bringing about a situation or result."},
    DV {hasName "creation", hasNote "Creation relation stereotype."},
    DV {hasName "termination", hasNote "Termination relation stereotype."},
    DV {hasName "manifestation", hasNote "Manifestation relation stereotype."},
    DV {hasName "triggers", hasNote "Triggers relation stereotype."}
