forbiddenKindAncestorTag(Ordium.Profile.OntoUML.ClassStereotype.quality).
forbiddenKindAncestorTag(Ordium.Profile.OntoUML.ClassStereotype.roleMixin).
specialises(?Sub, ?Base) :- categorisationGeneral(?C, ?Base), categorisationSpecial(?C, ?Sub).
specialisesPlus(?Sub, ?Base) :- specialises(?Sub, ?Base).
specialisesPlus(?Sub, ?Base) :- specialises(?Sub, ?Mid), specialisesPlus(?Mid, ?Base).
subtypeOrSame(?X, ?X) :- Clabject(?X).
subtypeOrSame(?Sub, ?Base) :- specialisesPlus(?Sub, ?Base).
iof(?X, ?T) :- hasDeclaredType(?X, ?T).
iof(?X, ?T) :- markedRef(?X, Ordium.Profile.OntoUML.RelationStereotype.instantiation, ?T).
iofPlus(?X, ?T) :- iof(?X, ?T).
iofPlus(?X, ?Super) :- iof(?X, ?T), specialisesPlus(?T, ?Super).
err_non_adjacent_iof(?X, ?T, ?PX, ?PT) :- iof(?X, ?T), effectivePotency(?X, ?PX), effectivePotency(?T, ?PT), ?PT != ?PX + 1.
err_cross_potency_specialization(?Sub, ?Base, ?PS, ?PB) :- specialises(?Sub, ?Base), effectivePotency(?Sub, ?PS), effectivePotency(?Base, ?PB), ?PS != ?PB.
ontoKind(?T) :- marked(?T, Ordium.Profile.OntoUML.ClassStereotype.kind).
ontoRelator(?T) :- marked(?T, Ordium.Profile.OntoUML.ClassStereotype.relator).
identityProvider(?T) :- marked(?T, ?Tag), identityProvider(?Tag).
sortal(?T) :- marked(?T, ?Tag), sortal(?Tag).
mixinType(?T) :- marked(?T, ?Tag), nonSortal(?Tag), ?Tag != Ordium.Profile.OntoUML.ClassStereotype.phaseMixin.
modeType(?T) :- marked(?T, Ordium.Profile.OntoUML.ClassStereotype.mode).
err_kind_bad_ancestor(?Kind, ?Ancestor, ?Tag) :- ontoKind(?Kind), specialisesPlus(?Kind, ?Ancestor), marked(?Ancestor, ?Tag), forbiddenKindAncestorTag(?Tag).
err_kind_bad_descendant(?Kind, ?Descendant, ?Tag) :- ontoKind(?Kind), specialisesPlus(?Descendant, ?Kind), marked(?Descendant, ?Tag), forbiddenKindDescendantTag(?Tag).
endType(?R, ?P, ?T) :- Relationship(?R), Participation(?P), hasCustodian(?P, ?R), hasRelatum(?P, ?T).
relationEndPair(?R, ?End1, ?End2) :- endType(?R, ?P1, ?End1), endType(?R, ?P2, ?End2), ?P1 != ?P2.
coSpecializedIn(?C, ?A, ?B) :- categorisationSpecial(?C, ?A), categorisationSpecial(?C, ?B), ?A != ?B.
explicitlyDisjoint(?A, ?B) :- Categorisation(?C), isDisjoint(?C, true), coSpecializedIn(?C, ?A, ?B).
hasIdentityProvider(?T, ?K) :- identityProvider(?K), subtypeOrSame(?T, ?K).
sameIdentityProvider(?A, ?B, ?K) :- hasIdentityProvider(?A, ?K), hasIdentityProvider(?B, ?K).
commonSupertype(?A, ?B, ?S) :- specialisesPlus(?A, ?S), specialisesPlus(?B, ?S), ?A != ?B.
binOverCase(?Source, ?Target, ?Source, Ordium.Library.ER2026OntoUMLMLTDiagnostics.DiagnosticReason.equalTypes) :- Clabject(?Source), Clabject(?Target), ?Source = ?Target.
binOverCase(?Source, ?Target, ?Target, Ordium.Library.ER2026OntoUMLMLTDiagnostics.DiagnosticReason.sourceSubtypeTarget) :- specialisesPlus(?Source, ?Target).
binOverCase(?Source, ?Target, ?Source, Ordium.Library.ER2026OntoUMLMLTDiagnostics.DiagnosticReason.targetSubtypeSource) :- specialisesPlus(?Target, ?Source).
binOverCase(?Source, ?Target, ?K, Ordium.Library.ER2026OntoUMLMLTDiagnostics.DiagnosticReason.commonIdentityProvider) :- sortal(?Source), sortal(?Target), ?Source != ?Target, sameIdentityProvider(?Source, ?Target, ?K), not explicitlyDisjoint(?Source, ?Target).
binOverCase(?Source, ?Target, ?S, Ordium.Library.ER2026OntoUMLMLTDiagnostics.DiagnosticReason.commonRelatorSupertype) :- ontoRelator(?Source), ontoRelator(?Target), ?Source != ?Target, commonSupertype(?Source, ?Target, ?S), not explicitlyDisjoint(?Source, ?Target).
binOverCase(?Source, ?Target, ?S, Ordium.Library.ER2026OntoUMLMLTDiagnostics.DiagnosticReason.commonModeSupertype) :- modeType(?Source), modeType(?Target), ?Source != ?Target, commonSupertype(?Source, ?Target, ?S), not explicitlyDisjoint(?Source, ?Target).
binOverCase(?Source, ?Target, ?S, Ordium.Library.ER2026OntoUMLMLTDiagnostics.DiagnosticReason.mixinsCommonSortal) :- mixinType(?Source), mixinType(?Target), ?Source != ?Target, sortal(?S), specialisesPlus(?S, ?Source), specialisesPlus(?S, ?Target).
hasSortalSubtype(?M) :- sortal(?S), specialisesPlus(?S, ?M).
binOverCase(?Source, ?Target, ?S, Ordium.Library.ER2026OntoUMLMLTDiagnostics.DiagnosticReason.mixinsCommonMixinSupertype) :- mixinType(?Source), mixinType(?Target), ?Source != ?Target, mixinType(?S), specialisesPlus(?Source, ?S), specialisesPlus(?Target, ?S), not hasSortalSubtype(?Source), not hasSortalSubtype(?Target).
warn_bin_over_case(?R, ?End1, ?End2, ?Support, ?Reason) :- relationEndPair(?R, ?End1, ?End2), binOverCase(?End1, ?End2, ?Support, ?Reason).
warn_bin_over_witness(?R, ?End1, ?End2, ?X) :- warn_bin_over_case(?R, ?End1, ?End2, _, _), iofPlus(?X, ?End1), iofPlus(?X, ?End2).
partitions(?Partition, ?Base) :- markedRef(?Partition, Ordium.Profile.MLT.PowertypeRelation.partitions, ?Base).
powertypeOf(?Powertype, ?Base) :- markedRef(?Powertype, Ordium.Profile.MLT.PowertypeRelation.powertypeOf, ?Base).
categorizes(?Categorizer, ?Base) :- markedRef(?Categorizer, Ordium.Profile.MLT.PowertypeRelation.categorizes, ?Base).
categorizes(?Categorizer, ?Base) :- partitions(?Categorizer, ?Base).
higherOrderClassifier(?Classifier, ?HBase, Ordium.Profile.MLT.HigherOrderKind.partition) :- partitions(?Classifier, ?HBase).
higherOrderClassifier(?Classifier, ?HBase, Ordium.Profile.MLT.HigherOrderKind.powertype) :- powertypeOf(?Classifier, ?HBase).
higherOrderClassifier(?Classifier, ?HBase, Ordium.Profile.MLT.HigherOrderKind.categorizer) :- categorizes(?Classifier, ?HBase).
partitionMember(?Partition, ?Member) :- partitions(?Partition, ?Base), iof(?Member, ?Partition), specialisesPlus(?Member, ?Base).
baseIndividual(?X, ?Base) :- effectivePotency(?X, 0), iofPlus(?X, ?Base).
coveredBy(?Partition, ?X) :- partitions(?Partition, ?Base), baseIndividual(?X, ?Base), partitionBranch(?Partition, ?Member), iofPlus(?X, ?Member).
err_partition_bad_member(?Partition, ?Base, ?Member) :- partitions(?Partition, ?Base), iof(?Member, ?Partition), not specialisesPlus(?Member, ?Base).
err_partition_missing(?Partition, ?Base, ?X) :- partitions(?Partition, ?Base), baseIndividual(?X, ?Base), not coveredBy(?Partition, ?X).
err_partition_overlap(?Partition, ?X, ?M1, ?M2) :- partitions(?Partition, ?Base), baseIndividual(?X, ?Base), partitionBranch(?Partition, ?M1), partitionBranch(?Partition, ?M2), ?M1 != ?M2, iofPlus(?X, ?M1), iofPlus(?X, ?M2).
err_partition_subtype_overlap(?Partition, ?BadType, ?M1, ?M2) :- partitions(?Partition, ?Base), partitionBranch(?Partition, ?M1), partitionBranch(?Partition, ?M2), ?M1 != ?M2, specialisesPlus(?BadType, ?M1), specialisesPlus(?BadType, ?M2).
err_partition_specialization(?P1, ?P2, ?Base) :- partitions(?P1, ?Base), partitions(?P2, ?Base), ?P1 != ?P2, specialisesPlus(?P1, ?P2).
err_partition_specialization_refined_base(?P1, ?P2, ?Base1, ?Base2) :- partitions(?P1, ?Base1), partitions(?P2, ?Base2), ?P1 != ?P2, ?Base1 != ?Base2, specialisesPlus(?P1, ?P2), specialisesPlus(?Base1, ?Base2).
err_partition_specialization_refined_base(?P1, ?P2, ?Base1, ?Base2) :- partitions(?P1, ?Base1), partitions(?P2, ?Base2), ?P1 != ?P2, ?Base1 != ?Base2, specialisesPlus(?P1, ?P2), specialisesPlus(?Base2, ?Base1).
err_classifier_bad_potency(?Classifier, ?HBase, ?HKind, ?PC, ?PB) :- higherOrderClassifier(?Classifier, ?HBase, ?HKind), effectivePotency(?Classifier, ?PC), effectivePotency(?HBase, ?PB), ?PC != ?PB + 1.
err_categorizer_bad_member(?Categorizer, ?Base, ?Member) :- categorizes(?Categorizer, ?Base), iof(?Member, ?Categorizer), not specialisesPlus(?Member, ?Base).
err_powertype_bad_member(?Powertype, ?Base, ?Member) :- powertypeOf(?Powertype, ?Base), iof(?Member, ?Powertype), not subtypeOrSame(?Member, ?Base).
forbiddenKindAncestorTag(?Tag) :- sortal(?Tag).
forbiddenKindDescendantTag(?Tag) :- nonSortal(?Tag), ?Tag != Ordium.Profile.OntoUML.ClassStereotype.phaseMixin.
nestedPartitionMember(?Partition, ?Member) :- partitionMember(?Partition, ?Member), partitionMember(?Partition, ?SuperMember), ?Member != ?SuperMember, specialisesPlus(?Member, ?SuperMember).
partitionBranch(?Partition, ?Member) :- partitionMember(?Partition, ?Member), not nestedPartitionMember(?Partition, ?Member).
