Action(?X) :- hasLinguisticType(?X, Action).
Argument(?X) :- hasLinguisticType(?X, Argument).
Artifact(?X) :- hasLinguisticType(?X, Artifact).
Atom(?X) :- hasLinguisticType(?X, Atom).
Attribute(?X) :- hasLinguisticType(?X, Attribute).
compoundInner(?I, ?A) :- Attribute(?I), hasCustodian(?I, ?A), Attribute(?A).
compoundParent(?A) :- Attribute(?A), Attribute(?I), hasCustodian(?I, ?A).
BehaviouralOrdium(?X) :- Parameter(?X).
BehaviouralOrdium(?X) :- Argument(?X).
BehaviouralOrdium(?X) :- Atom(?X).
BehaviouralOrdium(?X) :- Operation(?X).
BehaviouralOrdium(?X) :- Invocation(?X).
BehaviouralOrdium(?X) :- Action(?X).
Categorisation(?X) :- hasLinguisticType(?X, Categorisation).
categorisationGeneral(?C, ?X) :- Categorisation(?C), Intercalation(?I), hasCustodian(?I, ?C), isGeneralisation(?I, true), hasRelatum(?I, ?X).
violation(?C, categorisationMissingGeneral) :- Categorisation(?C), not hasGeneralSide(?C).
violation(?C, categorisationMissingSpecial) :- Categorisation(?C), not hasSpecialSide(?C).
categorisationSpecial(?C, ?X) :- Categorisation(?C), Intercalation(?I), hasCustodian(?I, ?C), isGeneralisation(?I, false), hasRelatum(?I, ?X).
Clabject(?X) :- Entity(?X).
Clabject(?X) :- Relationship(?X).
DataType(?X) :- hasLinguisticType(?X, DataType).
DataValue(?X) :- hasLinguisticType(?X, DataValue).
violation(?V, dataValueDatatypeSourceMissingViolation) :- DataValue(?V), hasCustodian(?V, ?C), not DataType(?C), not hasOfDataType(?V).
datatypeByCustodian(?V, ?T) :- DataValue(?V), hasCustodian(?V, ?T), DataType(?T).
datatypeByProperty(?V, ?T) :- DataValue(?V), ofDataType(?V, ?T).
tupleValueComponent(?V) :- DataValue(?V), hasCustodian(?V, ?W), DataValue(?W), hasOfDataType(?V).
tupleValueOf(?V, ?T) :- DataValue(?V), ofDataType(?V, ?T), tupleSlot(?S), hasCustodian(?S, ?T).
Entity(?X) :- hasLinguisticType(?X, Entity).
ImmanentOrdium(?X) :- Clabject(?X).
ImmanentOrdium(?X) :- Mediation(?X).
ImmanentOrdium(?X) :- Categorisation(?X).
ImmanentOrdium(?X) :- Moment(?X).
Intercalation(?X) :- hasLinguisticType(?X, Intercalation).
violation(?I, intercalationMissingRelatum) :- Intercalation(?I), hasCustodian(?I, ?C), Categorisation(?C), not hasRelatumPresent(?I).
Invocation(?X) :- hasLinguisticType(?X, Invocation).
Literal(?X) :- hasLinguisticType(?X, Literal).
Marker(?X) :- hasLinguisticType(?X, Marker).
auxiliaryFor(?A, ?X) :- Marker(?M), hasCustodian(?M, ?A), hasTag(?M, WardRole.auxiliary), refersTo(?M, ?X).
auxiliaryWard(?X, ?A) :- Marker(?A), hasCustodian(?A, ?X), hasTag(?A, WardRole.auxiliary).
markedRef(?X, ?Tag, ?Target) :- Marker(?M), hasCustodian(?M, ?X), hasTag(?M, ?Tag), refersTo(?M, ?Target).
marked(?X, ?Tag) :- Marker(?M), hasCustodian(?M, ?X), hasTag(?M, ?Tag).
Mediation(?X) :- Participation(?X).
Mediation(?X) :- Intercalation(?X).
Method(?X) :- hasLinguisticType(?X, Method).
Moment(?X) :- Method(?X).
Moment(?X) :- Attribute(?X).
Operation(?X) :- hasLinguisticType(?X, Operation).
Parameter(?X) :- hasLinguisticType(?X, Parameter).
Participation(?X) :- hasLinguisticType(?X, Participation).
violation(?P, lowerBoundAtMostUpperBound) :- Participation(?P), hasLowerBound(?P, ?L), hasUpperBound(?P, ?U), ?U != Unlimited, ?L > ?U.
violation(?P, mediationParticipationMissingRelatum) :- Participation(?P), hasCustodian(?P, ?R), Relationship(?R), not hasRelatumPresent(?P).
wellFormed(?P, participationMayInduceAccessPath) :- Participation(?P), isNavigableTo(?P, true).
violation(?P, slotParticipationHasRelatum) :- Participation(?P), hasCustodian(?P, ?E), Entity(?E), hasRelatumPresent(?P).
Relationship(?X) :- hasLinguisticType(?X, Relationship).
TranscendentOrdium(?X) :- Literal(?X).
TranscendentOrdium(?X) :- DataValue(?X).
TranscendentOrdium(?X) :- DataType(?X).
TranscendentOrdium(?X) :- Artifact(?X).
TranscendentOrdium(?X) :- Marker(?X).
Ordium(?X) :- hasLinguisticType(?X, Ordium).
Ordium(?X) :- ImmanentOrdium(?X).
Ordium(?X) :- TranscendentOrdium(?X).
Ordium(?X) :- BehaviouralOrdium(?X).
ancestor(?X, ?A) :- hasCustodian(?X, ?A).
ancestor(?X, ?A) :- hasCustodian(?X, ?M), ancestor(?M, ?A).
chainHead(?W, ?O) :- orderedWard(?W, ?O), not followsSomething(?W).
chained(?W, ?O) :- positionOf(?W, ?O, _).
componentAtPosition(?V, ?N) :- tupleValueComponent(?C), positionOf(?C, ?V, ?N).
violation(?A, compoundDurabilityUnequal) :- compoundInner(?I, ?A), hasDurability(?I, ?DI), hasDurability(?A, ?DA), ?DI != ?DA.
violation(?A, compoundParentHasDataType) :- compoundParent(?A), hasDataType(?A, _).
violation(?A, compoundParentHasValue) :- compoundParent(?A), hasValue(?A, _).
violation(?A, compoundParentMutabilityNonZero) :- compoundParent(?A), hasMutability(?A, ?M), ?M != 0.
violation(?X, custodianCycle) :- ancestor(?X, ?X), ?X != Ordium.
violation(?T, dtWardHomogeneityViolation) :- tupleSlot(?S), hasCustodian(?S, ?T), enumerationLiteral(?L), hasCustodian(?L, ?T).
enumerationLiteral(?V) :- datatypeByCustodian(?V, _), not hasOfDataType(?V).
followsSomething(?W) :- follows(?W, _).
hasGeneralSide(?C) :- categorisationGeneral(?C, _).
hasOfDataType(?V) :- ofDataType(?V, _).
hasRelatumPresent(?M) :- hasRelatum(?M, _).
hasSpecialSide(?C) :- categorisationSpecial(?C, _).
orderedWard(?W, ?T) :- tupleSlot(?W), hasCustodian(?W, ?T).
orderedWard(?W, ?V) :- tupleValueComponent(?W), hasCustodian(?W, ?V).
positionOf(?W, ?O, 1) :- chainHead(?W, ?O).
positionOf(?W, ?O, ?N) :- positionOf(?P, ?O, ?M), orderedWard(?W, ?O), follows(?W, ?P), ?N = ?M + 1.
violation(?X, singleCustodian) :- hasCustodian(?X, ?C1), hasCustodian(?X, ?C2), ?C1 != ?C2.
slotAtPosition(?T, ?N) :- tupleSlot(?S), positionOf(?S, ?T, ?N).
violation(?V, tupleArityMismatch) :- tupleValueOf(?V, ?T), componentAtPosition(?V, ?N), not slotAtPosition(?T, ?N).
violation(?V, tupleArityMismatch) :- tupleValueOf(?V, ?T), slotAtPosition(?T, ?N), not componentAtPosition(?V, ?N).
violation(?O, tupleOrderBranch) :- orderedWard(?W1, ?O), orderedWard(?W2, ?O), ?W1 != ?W2, orderedWard(?P, ?O), follows(?W1, ?P), follows(?W2, ?P).
violation(?O, tupleOrderMultipleHeads) :- chainHead(?W1, ?O), chainHead(?W2, ?O), ?W1 != ?W2.
violation(?O, tupleOrderUnchained) :- orderedWard(?W, ?O), not chained(?W, ?O).
violation(?V, tuplePositionalTypeMismatch) :- tupleValueOf(?V, ?T), tupleValueComponent(?C), positionOf(?C, ?V, ?N), ofDataType(?C, ?DC), tupleSlot(?S), positionOf(?S, ?T, ?N), ofDataType(?S, ?DS), ?DC != ?DS.
tupleSlot(?V) :- datatypeByCustodian(?V, _), datatypeByProperty(?V, _).
violation(?C, categorisationManyToMany) :- manyGenerals(?C), manySpecials(?C).
violation(?X, declaredTypeSingleValued) :- hasDeclaredType(?X, ?T1), hasDeclaredType(?X, ?T2), ?T1 != ?T2.
effectivePotency(?X, ?P) :- Clabject(?X), hasPotency(?X, ?P).
effectivePotency(?X, 0) :- Clabject(?X), not hasPotency(?X, _).
manyGenerals(?C) :- categorisationGeneral(?C, ?X), categorisationGeneral(?C, ?Y), ?X != ?Y.
manySpecials(?C) :- categorisationSpecial(?C, ?X), categorisationSpecial(?C, ?Y), ?X != ?Y.
violation(?X, potencyStep) :- hasDeclaredType(?X, ?T), effectivePotency(?X, ?P), effectivePotency(?T, ?Q), ?P != ?Q - 1.
