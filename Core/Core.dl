hasNote(Ordium.Core, "Minimized PAMoLa core vocabulary and rules required by the ER diagnostic reproduction.") .
hasNote(Ordium.Core.Argument, "badge AG, supertype BehaviouralOrdium") .
hasNote(Ordium.Core.Argument.bindsTo, "type Ordium") .
hasNote(Ordium.Core.Argument.fills, "type Parameter, optional") .
hasNote(Ordium.Core.Atom, "badge AO, supertype BehaviouralOrdium") .
hasNote(Ordium.Core.Atom.hasPredicate, "type Ordium") .
hasNote(Ordium.Core.Atom.isExplicit, "type Boolean, default true") .
hasNote(Ordium.Core.Atom.isNegated, "type Boolean, default false") .
hasNote(Ordium.Core.Categorisation, "badge CA, supertype ImmanentOrdium") .
hasNote(Ordium.Core.Categorisation.isComplete, "type Boolean, default false") .
hasNote(Ordium.Core.Categorisation.isDisjoint, "type Boolean, default false") .
hasNote(Ordium.Core.Clabject, "abstract, supertype ImmanentOrdium — identity-bearing, ontologically classifiable") .
hasNote(Ordium.Core.Clabject.hasDeclaredType, "type Clabject, optional — absent = no declared ontological type; uninterpreted by the core, classification discipline is profile content") .
hasNote(Ordium.Core.Clabject.hasPotency, "type NonNegativeInteger, optional — uninterpreted by the core; classification profiles (e.g. Ordium.Profile.LML) give it meaning, LML reading an absent potency as 0") .
hasNote(Ordium.Core.DataType, "badge DT, supertype TranscendentOrdium") .
hasNote(Ordium.Core.DataValue, "badge DV, supertype TranscendentOrdium") .
hasNote(Ordium.Core.DataValue.ofDataType, "type DataType, optional — datatype source; XOR with datatype-by-custodian") .
hasNote(Ordium.Core.Entity, "badge EN, supertype Clabject") .
hasNote(Ordium.Core.Intercalation, "badge IC, supertype Mediation") .
hasNote(Ordium.Core.Intercalation.isGeneralisation, "type Boolean, default false") .
hasNote(Ordium.Core.Literal, "badge LI, supertype TranscendentOrdium") .
hasNote(Ordium.Core.Literal.hasLexeme, "type Ordium — Ordium-typed so textual/binary/artefact lexemes are uniform; plain text written as a quoted string") .
hasNote(Ordium.Core.Marker, "badge MK, supertype TranscendentOrdium") .
hasNote(Ordium.Core.Marker.hasTag, "type DataValue") .
hasNote(Ordium.Core.Marker.refersTo, "type Ordium, optional") .
hasNote(Ordium.Core.Mediation, "abstract, supertype ImmanentOrdium") .
hasNote(Ordium.Core.Mediation.hasRelatum, "type Ordium, optional — required for mediation participations/intercalations (custodian RE/CA, enforced by rule); absent by design on multi-attribute slot participations (custodian EN) — DR-006") .
hasNote(Ordium.Core.Parameter, "badge PM, supertype BehaviouralOrdium") .
hasNote(Ordium.Core.Parameter.hasType, "type Ordium") .
hasNote(Ordium.Core.Parameter.isExistential, "type Boolean, default false") .
hasNote(Ordium.Core.Participation, "badge PA, supertype Mediation") .
hasNote(Ordium.Core.Participation.hasRoleName, "type String, default §") .
hasNote(Ordium.Core.Relationship, "badge RE, supertype Clabject") .
hasNote(Ordium.Core.Relationship.hasAssociationName, "type String, default §") .
hasNote(Ordium.Core.follows, "type Ordium, optional — general-purpose sequencing pointer; NOT ward ordering; target unconstrained") .
hasNote(Ordium.Core.hasCustodian, "type Ordium — custodian (locality/naming spine)") .
hasNote(Ordium.Core.hasFQN, "type FQN, default <derived> — derived fully-qualified name") .
hasNote(Ordium.Core.hasLinguisticType, "type Ordium — the fixed core category this ordium instantiates") .
hasNote(Ordium.Core.hasName, "type Name, default <auto created> — local name") .
hasNote(Ordium.Core.hasNote, "type String — documentation") .
hasNote(Ordium.Core.hasPID, "type PID, default <auto created> — stable lifetime identity") .

% ============================================================================
% B) EXECUTABLE FACTS AND RULES OWNED BY THIS SOURCE
% ============================================================================
Categorisation(?X) :- hasLinguisticType(?X, Categorisation) .
categorisationGeneral(?C, ?X) :- Categorisation(?C), Intercalation(?I), hasCustodian(?I, ?C), isGeneralisation(?I, true), hasRelatum(?I, ?X) .
categorisationSpecial(?C, ?X) :- Categorisation(?C), Intercalation(?I), hasCustodian(?I, ?C), isGeneralisation(?I, false), hasRelatum(?I, ?X) .
Clabject(?X) :- Entity(?X) .
Entity(?X) :- hasLinguisticType(?X, Entity) .
Intercalation(?X) :- hasLinguisticType(?X, Intercalation) .
Marker(?X) :- hasLinguisticType(?X, Marker) .
markedRef(?X, ?Tag, ?Target) :- Marker(?M), hasCustodian(?M, ?X), hasTag(?M, ?Tag), refersTo(?M, ?Target) .
marked(?X, ?Tag) :- Marker(?M), hasCustodian(?M, ?X), hasTag(?M, ?Tag) .
Participation(?X) :- hasLinguisticType(?X, Participation) .
Relationship(?X) :- hasLinguisticType(?X, Relationship) .
endType(?R, ?P, ?T) :- Relationship(?R), Participation(?P), hasCustodian(?P, ?R), hasRelatum(?P, ?T) .
relationEndPair(?R, ?End1, ?End2) :- endType(?R, ?P1, ?End1), endType(?R, ?P2, ?End2), ?P1 != ?P2 .
