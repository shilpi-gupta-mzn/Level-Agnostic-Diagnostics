    },
  OM {hasName Clabject, hasNote "abstract ontological classifier/instance carrier",
      OM {hasName hasDeclaredType, hasNote "type Clabject, optional — absent = no declared ontological type; uninterpreted by the core, classification discipline is profile content"},
      OM {hasName hasPotency, hasNote "type NonNegativeInteger, optional — uninterpreted by the core; classification profiles (e.g. Ordium.Profile.LML) give it meaning, LML reading an absent potency as 0"},
      EN {hasName rule,
          AO {hasName Clabject, hasPredicate Ordium.Core.Clabject,
                    AG {hasName AG__1, bindsTo Ordium.Core.Clabject.rule.Clabject.X, fills Ordium.Core.Clabject.rule.Clabject.X},
                    AO {hasName AO__1, hasPredicate Ordium.Core.Entity,
