                      AG {hasName AG__2, follows Ordium.Core.Categorisation.rule.categorisationSpecial__2.AO__5.AG__1, bindsTo Ordium.Core.Categorisation.rule.categorisationSpecial__2.X, fills Ordium.Core.Categorisation.rule.categorisationSpecial__2.X}
                    },
