                      AG {hasName AG__2, follows Ordium.Core.Intercalation.rule.Intercalation.AO__1.AG__1, bindsTo Ordium.Core.Intercalation}
                    },
                    PM {hasName X, hasType Ordium}
                  }
          }
    },
  OM {hasName Marker, hasNote "badge MK; profile annotation/reference",
