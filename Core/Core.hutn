                      AG {hasName AG__2, follows Ordium.Core.Categorisation.rule.categorisationGeneral__2.AO__4.AG__1, bindsTo Ordium.Core.DataType.Boolean.True}
                    },
                    AO {hasName AO__5, follows Ordium.Core.Categorisation.rule.categorisationGeneral__2.AO__4, hasPredicate Ordium.Core.Mediation.hasRelatum,
                      AG {hasName AG__1, bindsTo Ordium.Core.Categorisation.rule.categorisationGeneral__2.I, fills Ordium.Core.Categorisation.rule.categorisationGeneral__2.I},
                      AG {hasName AG__2, follows Ordium.Core.Categorisation.rule.categorisationGeneral__2.AO__5.AG__1, bindsTo Ordium.Core.Categorisation.rule.categorisationGeneral__2.X, fills Ordium.Core.Categorisation.rule.categorisationGeneral__2.X}
                    },
                    PM {hasName C, hasType Ordium},
                    PM {hasName I, hasType Ordium},
                    PM {hasName X, hasType Ordium}
                  },
          AO {hasName categorisationSpecial, hasPredicate Ordium.Core.Categorisation.rule.categorisationSpecial},
          AO {hasName categorisationSpecial__2, hasPredicate Ordium.Core.Categorisation.rule.categorisationSpecial,
                    AG {hasName AG__1, bindsTo Ordium.Core.Categorisation.rule.categorisationSpecial__2.C, fills Ordium.Core.Categorisation.rule.categorisationSpecial__2.C},
                    AG {hasName AG__2, follows Ordium.Core.Categorisation.rule.categorisationSpecial__2.AG__1, bindsTo Ordium.Core.Categorisation.rule.categorisationSpecial__2.X, fills Ordium.Core.Categorisation.rule.categorisationSpecial__2.X},
                    AO {hasName AO__1, hasPredicate Ordium.Core.Categorisation,
