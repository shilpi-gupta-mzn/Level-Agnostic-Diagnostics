    },
  OM {hasName follows, hasNote "type Ordium, optional — general-purpose sequencing pointer; NOT ward ordering; target unconstrained"},
  OM {hasName hasCustodian, hasNote "type Ordium — custodian (locality/naming spine)"},
  OM {hasName hasFQN, hasNote "type FQN, default <derived> — derived fully-qualified name"},
  OM {hasName hasLinguisticType, hasNote "type Ordium — the fixed core category this ordium instantiates"},
  OM {hasName hasName, hasNote "type Name, default <auto created> — local name"},
