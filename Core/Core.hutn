                      AG {hasName AG__2, follows Ordium.Core.Categorisation.rule.categorisationSpecial__2.AO__4.AG__1, bindsTo Ordium.Core.DataType.Boolean.False}
                    },
                    AO {hasName AO__5, follows Ordium.Core.Categorisation.rule.categorisationSpecial__2.AO__4, hasPredicate Ordium.Core.Mediation.hasRelatum,
