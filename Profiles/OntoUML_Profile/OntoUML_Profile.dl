hasNote(Ordium.Profile.OntoUML.ClassFamily.identityProvider, "Sortal stereotype that supplies an identity principle.") .
hasNote(Ordium.Profile.OntoUML.ClassFamily.sortal, "Stereotype for class types whose instances share an identity principle.") .
hasNote(Ordium.Profile.OntoUML.ClassStereotype, "OntoUML class stereotype values. The DataValue name is the default lexeme.") .
