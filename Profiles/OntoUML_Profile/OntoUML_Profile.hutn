EN {hasName "OntoUML", hasFQN "Ordium.Profile.OntoUML",
  hasNote "Fixture-specific OntoUML vocabulary and stereotype-family facts used by the level-agnostic diagnostics reproduction artifact.",
  hasCustodian Ordium.Profile, hasLinguisticType Ordium.Core.Entity,
  DT {hasName "ClassStereotype",
    DV {hasName "kind", hasNote "Rigid sortal that supplies an identity principle."},
    DV {hasName "role", hasNote "Anti-rigid sortal instantiated in a relational context."},
    DV {hasName "subkind", hasNote "Rigid specialization of an identity provider."}
  },
  DT {hasName "ClassFamily",
    DV {hasName "sortal", hasNote "Predicate identity for the sortal stereotype family."},
    DV {hasName "identityProvider", hasNote "Predicate identity for stereotypes that provide identity."}
  },
  DT {hasName "RelationStereotype",
    DV {hasName "instantiation", hasNote "Profile relation used for explicit additional direct classification."}
  },
  EN {hasName "rule",
    AO {hasName "kindIsSortal", hasPredicate Ordium.Profile.OntoUML.ClassFamily.sortal, hasNote "OntoUML class stereotype kind is a member of class family sortal.",
          AG {hasName "value", bindsTo Ordium.Profile.OntoUML.ClassStereotype.kind}
        },
    AO {hasName "roleIsSortal", hasPredicate Ordium.Profile.OntoUML.ClassFamily.sortal, hasNote "OntoUML class stereotype role is a member of class family sortal.",
          AG {hasName "value", bindsTo Ordium.Profile.OntoUML.ClassStereotype.role}
        },
    AO {hasName "kindIsIdentityProvider", hasPredicate Ordium.Profile.OntoUML.ClassFamily.identityProvider, hasNote "OntoUML class stereotype kind is a member of class family identityProvider.",
          AG {hasName "value", bindsTo Ordium.Profile.OntoUML.ClassStereotype.kind}
        }
  }
}
