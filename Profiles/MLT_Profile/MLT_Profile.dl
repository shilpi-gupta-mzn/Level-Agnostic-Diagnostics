% ============================================================================
% A) MINIMIZED SOURCE-DEFINITION FACTS
% ============================================================================
hasCustodian(Ordium.Profile.MLT, Ordium.Profile) .
hasCustodian(Ordium.Profile.MLT.PowertypeRelation, Ordium.Profile.MLT) .
hasCustodian(Ordium.Profile.MLT.PowertypeRelation.categorizes, Ordium.Profile.MLT.PowertypeRelation) .
hasCustodian(Ordium.Profile.MLT.PowertypeRelation.partitions, Ordium.Profile.MLT.PowertypeRelation) .
hasCustodian(Ordium.Profile.MLT.PowertypeRelation.powertypeOf, Ordium.Profile.MLT.PowertypeRelation) .
hasLinguisticType(Ordium.Profile.MLT, Entity) .
hasLinguisticType(Ordium.Profile.MLT.PowertypeRelation, DataType) .
hasLinguisticType(Ordium.Profile.MLT.PowertypeRelation.categorizes, DataValue) .
hasLinguisticType(Ordium.Profile.MLT.PowertypeRelation.partitions, DataValue) .
hasLinguisticType(Ordium.Profile.MLT.PowertypeRelation.powertypeOf, DataValue) .
hasName(Ordium.Profile.MLT, MLT) .
hasName(Ordium.Profile.MLT.PowertypeRelation, PowertypeRelation) .
hasName(Ordium.Profile.MLT.PowertypeRelation.categorizes, categorizes) .
hasName(Ordium.Profile.MLT.PowertypeRelation.partitions, partitions) .
hasName(Ordium.Profile.MLT.PowertypeRelation.powertypeOf, powertypeOf) .
hasNote(Ordium.Profile.MLT, "Minimized facts-only MLT vocabulary referenced by the running model and LML rules.") .
hasNote(Ordium.Profile.MLT.PowertypeRelation.categorizes, "Higher-order classifier whose members specialize the referenced base type.") .
hasNote(Ordium.Profile.MLT.PowertypeRelation.partitions, "Categorizer intended to be complete and disjoint over the referenced base type.") .
hasNote(Ordium.Profile.MLT.PowertypeRelation.powertypeOf, "Classifier whose members are the base type and/or its specializations, under the structural approximation used in this artifact.") .

% ============================================================================
% B) EXECUTABLE FACTS AND RULES OWNED BY THIS SOURCE
% ============================================================================
partitions(?Partition, ?Base) :- markedRef(?Partition, Ordium.Profile.MLT.PowertypeRelation.partitions, ?Base) .
categorizes(?Categorizer, ?Base) :- markedRef(?Categorizer, Ordium.Profile.MLT.PowertypeRelation.categorizes, ?Base) .
partitionMember(?Partition, ?Member) :- partitions(?Partition, ?Base), iof(?Member, ?Partition), specialisesPlus(?Member, ?Base) .
baseIndividual(?X, ?Base) :- effectivePotency(?X, 0), iofPlus(?X, ?Base) .
coveredBy(?Partition, ?X) :- partitions(?Partition, ?Base), baseIndividual(?X, ?Base), partitionBranch(?Partition, ?Member), iofPlus(?X, ?Member) .
err_partition_bad_member(?Partition, ?Base, ?Member) :- partitions(?Partition, ?Base), iof(?Member, ?Partition), ~specialisesPlus(?Member, ?Base) .
err_partition_missing(?Partition, ?Base, ?X) :- partitions(?Partition, ?Base), baseIndividual(?X, ?Base), ~coveredBy(?Partition, ?X) .
err_partition_overlap(?Partition, ?X, ?M1, ?M2) :- partitions(?Partition, ?Base), baseIndividual(?X, ?Base), partitionBranch(?Partition, ?M1), partitionBranch(?Partition, ?M2), ?M1 != ?M2, iofPlus(?X, ?M1), iofPlus(?X, ?M2) .
err_partition_subtype_overlap(?Partition, ?BadType, ?M1, ?M2) :- partitions(?Partition, ?Base), partitionBranch(?Partition, ?M1), partitionBranch(?Partition, ?M2), ?M1 != ?M2, specialisesPlus(?BadType, ?M1), specialisesPlus(?BadType, ?M2) .
err_partition_specialization(?P1, ?P2, ?Base) :- partitions(?P1, ?Base), partitions(?P2, ?Base), ?P1 != ?P2, specialisesPlus(?P1, ?P2) .
err_categorizer_bad_member(?Categorizer, ?Base, ?Member) :- categorizes(?Categorizer, ?Base), iof(?Member, ?Categorizer), ~specialisesPlus(?Member, ?Base) .
nestedPartitionMember(?Partition, ?Member) :- partitionMember(?Partition, ?Member), partitionMember(?Partition, ?SuperMember), ?Member != ?SuperMember, specialisesPlus(?Member, ?SuperMember) .
partitionBranch(?Partition, ?Member) :- partitionMember(?Partition, ?Member), ~nestedPartitionMember(?Partition, ?Member) .
