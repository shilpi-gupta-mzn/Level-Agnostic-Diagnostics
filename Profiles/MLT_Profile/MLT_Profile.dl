
powertypeRelationTerm(Ordium.Profile.MLT.PowertypeRelation.powertypeOf).
powertypeRelationTerm(Ordium.Profile.MLT.PowertypeRelation.categorizes).
powertypeRelationTerm(Ordium.Profile.MLT.PowertypeRelation.partitions).

higherOrderKindTerm(Ordium.Profile.MLT.HigherOrderKind.powertype).
higherOrderKindTerm(Ordium.Profile.MLT.HigherOrderKind.categorizer).
higherOrderKindTerm(Ordium.Profile.MLT.HigherOrderKind.partition).

partitions(?Partition, ?Base) :-
     markedRef(?Partition,
       Ordium.Profile.MLT.PowertypeRelation.partitions, ?Base).

 powertypeOf(?Powertype, ?Base) :-
     markedRef(?Powertype,
       Ordium.Profile.MLT.PowertypeRelation.powertypeOf, ?Base).

 categorizes(?Categorizer, ?Base) :-
     markedRef(?Categorizer,
       Ordium.Profile.MLT.PowertypeRelation.categorizes, ?Base).

 categorizes(?Categorizer, ?Base) :-
     partitions(?Categorizer, ?Base).

 higherOrderClassifier(?Classifier, ?Base,
     Ordium.Profile.MLT.HigherOrderKind.partition) :-
     partitions(?Classifier, ?Base).

 higherOrderClassifier(?Classifier, ?Base,
     Ordium.Profile.MLT.HigherOrderKind.powertype) :-
     powertypeOf(?Classifier, ?Base).

 higherOrderClassifier(?Classifier, ?Base,
     Ordium.Profile.MLT.HigherOrderKind.categorizer) :-
     categorizes(?Classifier, ?Base).

 partitionMember(?Partition, ?Member) :-
     partitions(?Partition, ?Base),
     iof(?Member, ?Partition),
     specialisesPlus(?Member, ?Base).
